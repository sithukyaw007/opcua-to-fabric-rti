# Copy to .env and fill in. Never commit .env to Git.
# Keep comments on their own lines: some tools (systemd, docker --env-file) don't strip inline comments.

# ---------------- OPC UA: one machine ----------------
OPCUA_URL=opc.tcp://localhost:50000
MACHINE_ID=machine-01
# NodeId -> tag name, e.g. {"ns=3;s=SpikeData": "Temperature"}. Leave empty to use the OPC PLC simulator defaults.
NODE_MAP_JSON=
# Optional username and password
OPCUA_USER=
OPCUA_PASSWORD=
# Optional security: Policy,Mode,client_cert,client_key[,server_cert]
# Add the server certificate (5th value) so the bridge only trusts that server, e.g.
# Basic256Sha256,SignAndEncrypt,certs/client_cert.der,certs/client_key.pem,certs/server_cert.der
OPCUA_SECURITY=
# How often the server sends changes (ms)
PUBLISHING_INTERVAL_MS=1000
# How often the server samples each tag (ms). Empty = same as PUBLISHING_INTERVAL_MS
SAMPLING_INTERVAL_MS=
# Values kept per tag between two publishes. 1 = latest value only.
# To keep every sample, use at least PUBLISHING_INTERVAL_MS / SAMPLING_INTERVAL_MS.
MONITORED_QUEUE_SIZE=1

# ---------------- OPC UA: several machines (overrides the single-machine settings) ----------------
# MACHINES_FILE=config/machines.json

# Experiment / run ID added to every event (links telemetry to DOE runs and specimens)
RUN_ID=

# ---------------- Fabric Eventstream (custom endpoint source) ----------------
# Option 1 - quick start: Eventstream > custom endpoint > Details > Event Hub > SAS Key Authentication
#            > "Connection string-primary key"
EVENTSTREAM_CONNECTION_STRING=

# Option 2 - production: Microsoft Entra ID (service principal with Contributor on the workspace)
#            Values from the "Entra ID Authentication" tab of the custom endpoint
EVENTSTREAM_NAMESPACE=
EVENTSTREAM_HUB=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# ---------------- Tuning ----------------
# true = AMQP over WebSockets on port 443; false = AMQP on port 5671
USE_WEBSOCKETS=true
# SDK retries per send before events go to the spool file
SEND_RETRIES=3
BATCH_WINDOW_S=1.0
MAX_BATCH_EVENTS=500
# In-memory queue between OPC UA and the sender (events)
QUEUE_SIZE=100000
SPOOL_FILE=unsent_events.jsonl
SPOOL_MAX_MB=500
LOG_LEVEL=INFO
